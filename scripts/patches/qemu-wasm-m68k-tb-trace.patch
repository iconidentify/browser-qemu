+#ifdef C89_BROWSER_QEMU_M68K_TB_TRACE
+static const char *c89_browser_qemu_m68k_tb_phase(uint32_t pc)
+{
+    if (pc >= 0x40881000 && pc <= 0x40883000) {
+        return "rom-late-loop";
+    }
+    if (pc >= 0x40800000 && pc <= 0x40802000) {
+        return "rom-low-window";
+    }
+    if (pc >= 0x40800000 && pc < 0x40900000) {
+        return "quadra-rom";
+    }
+    if (pc < 0x01000000) {
+        return "low-memory";
+    }
+    return "other";
+}
+
+static bool c89_browser_qemu_m68k_tb_watch_pc(uint32_t pc)
+{
+    return (pc >= 0x40881000 && pc <= 0x40883000) ||
+           (pc >= 0x40800000 && pc <= 0x40802000);
+}
+
+static uint32_t c89_browser_qemu_m68k_tb_pc(const TranslationBlock *tb)
+{
+    return tb ? (uint32_t)tb->pc : 0;
+}
+
+static uint32_t c89_browser_qemu_m68k_tb_flags(const TranslationBlock *tb)
+{
+    return tb ? tb->flags : 0;
+}
+
+static uint32_t c89_browser_qemu_m68k_tb_cflags(const TranslationBlock *tb)
+{
+    return tb ? tb_cflags(tb) : 0;
+}
+
+static uint32_t c89_browser_qemu_m68k_tb_icount(const TranslationBlock *tb)
+{
+    return tb ? tb->icount : 0;
+}
+
+static void c89_browser_qemu_m68k_tb_trace(const char *event,
+                                           CPUArchState *env,
+                                           const TranslationBlock *start_tb,
+                                           const TranslationBlock *last_tb,
+                                           uintptr_t raw_ret,
+                                           int tb_exit)
+{
+    static uint32_t last_sig;
+    static unsigned long long seq;
+    static unsigned log_count;
+    uint32_t env_pc = env->pc;
+    uint32_t start_pc = c89_browser_qemu_m68k_tb_pc(start_tb);
+    uint32_t last_pc = c89_browser_qemu_m68k_tb_pc(last_tb);
+    uint32_t sig = env_pc ^ (start_pc << 1) ^ (last_pc << 2) ^
+                   ((uint32_t)tb_exit << 27) ^ (uint32_t)event[0];
+    bool watched = c89_browser_qemu_m68k_tb_watch_pc(env_pc) ||
+                   c89_browser_qemu_m68k_tb_watch_pc(start_pc) ||
+                   c89_browser_qemu_m68k_tb_watch_pc(last_pc);
+    bool changed = sig != last_sig;
+    bool periodic = (seq % 200000ULL) == 0;
+
+    seq++;
+    if (!watched && !changed && !periodic) {
+        return;
+    }
+    if (log_count >= 2000 && !watched && !periodic) {
+        return;
+    }
+    if (log_count >= 160 && !watched && !periodic) {
+        return;
+    }
+
+    fprintf(stderr,
+            "[c89-m68k-tb] n=%llu event=%s envpc=0x%08x phase=%s "
+            "sr=0x%04x d3=0x%08x d5=0x%08x "
+            "a2=0x%08x a3=0x%08x a5=0x%08x a6=0x%08x a7=0x%08x "
+            "tcr=0x%04x srp=0x%08x urp=0x%08x "
+            "start=%p start_pc=0x%08x start_flags=0x%08x "
+            "start_cflags=0x%08x start_icount=%u "
+            "last=%p last_pc=0x%08x last_flags=0x%08x "
+            "last_cflags=0x%08x last_icount=%u raw_ret=0x%08" PRIxPTR
+            " exit=%d\n",
+            seq, event, env_pc, c89_browser_qemu_m68k_tb_phase(env_pc),
+            env->sr, env->dregs[3], env->dregs[5],
+            env->aregs[2], env->aregs[3], env->aregs[5], env->aregs[6],
+            env->aregs[7], env->mmu.tcr, env->mmu.srp, env->mmu.urp,
+            start_tb, start_pc, c89_browser_qemu_m68k_tb_flags(start_tb),
+            c89_browser_qemu_m68k_tb_cflags(start_tb),
+            c89_browser_qemu_m68k_tb_icount(start_tb),
+            last_tb, last_pc, c89_browser_qemu_m68k_tb_flags(last_tb),
+            c89_browser_qemu_m68k_tb_cflags(last_tb),
+            c89_browser_qemu_m68k_tb_icount(last_tb),
+            raw_ret, tb_exit);
+    fflush(stderr);
+
+    last_sig = sig;
+    log_count++;
+}
+#endif
 
