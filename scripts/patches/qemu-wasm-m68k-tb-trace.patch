+{
+    static uint32_t last_sig;
+    static unsigned long long seq;
+    static unsigned log_count;
+    uint32_t pc = env->pc;
+    uint32_t sig = pc ^ res ^ (uint32_t)(uintptr_t)start_tb_ptr ^
+                   ((uint32_t)fidx << 24) ^ (uint32_t)path[0];
+    bool watched = c89_browser_qemu_wasm32_tb_watch_pc(pc);
+    bool changed = sig != last_sig;
+    bool periodic = (seq % 200000ULL) == 0;
+
+    seq++;
+    if (!watched && !changed && !periodic) {
+        return;
+    }
+    if (log_count >= 2000 && !watched && !periodic) {
+        return;
+    }
+    if (log_count >= 160 && !watched && !periodic) {
+        return;
+    }
+
+    fprintf(stderr,
+            "[c89-wasm32-tb] n=%llu path=%s envpc=0x%08x "
+            "start_tb_ptr=%p ctx_tb_ptr=%p res=0x%08x fidx=%d counter=%d\n",
+            seq, path, pc, start_tb_ptr, ctx.tb_ptr, res, fidx, counter);
+    fflush(stderr);
+
+    last_sig = sig;
+    log_count++;
+}
+#endif
