diff --git a/hw/misc/mos6522.c b/hw/misc/mos6522.c
index 0b9621d8..a6dfcfc6 100644
--- a/hw/misc/mos6522.c
+++ b/hw/misc/mos6522.c
@@ -175,6 +175,11 @@ static void set_counter(MOS6522State *s, MOS6522Timer *ti, unsigned int val)
     trace_mos6522_set_counter(1 + ti->index, val);
     ti->load_time = get_load_time(s, ti);
     ti->counter_value = val;
+#ifdef C89_BROWSER_QEMU_VIA_T2_ONESHOT_HACK
+    if (ti->index == 1) {
+        ti->armed = true;
+    }
+#endif
     if (ti->index == 0) {
         mos6522_timer1_update(s, ti, ti->load_time);
     } else {
@@ -242,6 +247,13 @@ static void mos6522_timer2_update(MOS6522State *s, MOS6522Timer *ti,
     if (!ti->timer) {
         return;
     }
+#ifdef C89_BROWSER_QEMU_VIA_T2_ONESHOT_HACK
+    if (!ti->armed) {
+        ti->next_irq_time = INT64_MAX;
+        timer_del(ti->timer);
+        return;
+    }
+#endif
     ti->next_irq_time = get_next_irq_time(s, ti, current_time);
     if ((s->ier & T2_INT) == 0) {
         timer_del(ti->timer);
@@ -251,6 +262,17 @@ static void mos6522_timer2_update(MOS6522State *s, MOS6522Timer *ti,
     }
 }
 
+#ifdef C89_BROWSER_QEMU_VIA_T2_ONESHOT_HACK
+static void mos6522_timer2_disarm(MOS6522Timer *ti)
+{
+    ti->armed = false;
+    ti->next_irq_time = INT64_MAX;
+    if (ti->timer) {
+        timer_del(ti->timer);
+    }
+}
+#endif
+
 static void mos6522_timer1(void *opaque)
 {
     MOS6522State *s = opaque;
@@ -265,7 +287,11 @@ static void mos6522_timer2(void *opaque)
     MOS6522State *s = opaque;
     MOS6522Timer *ti = &s->timers[1];
 
+#ifdef C89_BROWSER_QEMU_VIA_T2_ONESHOT_HACK
+    mos6522_timer2_disarm(ti);
+#else
     mos6522_timer2_update(s, ti, ti->next_irq_time);
+#endif
     s->ifr |= T2_INT;
     mos6522_update_irq(s);
 }
@@ -306,7 +332,11 @@ uint64_t mos6522_read(void *opaque, hwaddr addr, unsigned size)
         s->ifr |= T1_INT;
     }
     if (now >= s->timers[1].next_irq_time) {
+#ifdef C89_BROWSER_QEMU_VIA_T2_ONESHOT_HACK
+        mos6522_timer2_disarm(&s->timers[1]);
+#else
         mos6522_timer2_update(s, &s->timers[1], now);
+#endif
         s->ifr |= T2_INT;
     }
     switch (addr) {
@@ -615,6 +645,9 @@ static const VMStateDescription vmstate_mos6522_timer = {
         VMSTATE_UINT16(counter_value, MOS6522Timer),
         VMSTATE_INT64(load_time, MOS6522Timer),
         VMSTATE_INT64(next_irq_time, MOS6522Timer),
+#ifdef C89_BROWSER_QEMU_VIA_T2_ONESHOT_HACK
+        VMSTATE_BOOL(armed, MOS6522Timer),
+#endif
         VMSTATE_TIMER_PTR(timer, MOS6522Timer),
         VMSTATE_END_OF_LIST()
     }
@@ -665,6 +698,10 @@ static void mos6522_reset_hold(Object *obj)
 
     s->timers[1].frequency = s->frequency;
     s->timers[1].latch = 0xffff;
+    s->timers[1].next_irq_time = INT64_MAX;
+#ifdef C89_BROWSER_QEMU_VIA_T2_ONESHOT_HACK
+    s->timers[1].armed = false;
+#endif
     timer_del(s->timers[1].timer);
 }
 
