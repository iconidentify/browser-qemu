+#ifdef C89_BROWSER_QEMU_ESP_TRACE
+static const char *c89_esp_reg_name(uint32_t reg)
+{
+    switch (reg) {
+    case ESP_TCLO:
+        return "TCLO";
+    case ESP_TCMID:
+        return "TCMID";
+    case ESP_FIFO:
+        return "FIFO";
+    case ESP_CMD:
+        return "CMD";
+    case ESP_RSTAT:
+        return "RSTAT/WBUSID";
+    case ESP_RINTR:
+        return "RINTR/WSEL";
+    case ESP_RSEQ:
+        return "RSEQ/WSYNTP";
+    case ESP_RFLAGS:
+        return "RFLAGS/WSYNO";
+    case ESP_CFG1:
+        return "CFG1";
+    case ESP_RRES1:
+        return "RRES1/WCCF";
+    case ESP_RRES2:
+        return "RRES2/WTEST";
+    case ESP_CFG2:
+        return "CFG2";
+    case ESP_CFG3:
+        return "CFG3";
+    case ESP_RES3:
+        return "RES3";
+    case ESP_TCHI:
+        return "TCHI";
+    case ESP_RES4:
+        return "RES4";
+    case 0xfd:
+        return "PDMA_CB";
+    case 0xfe:
+        return "PDMA";
+    case 0xff:
+        return "event";
+    default:
+        return "unknown";
+    }
+}
+
+static bool c89_esp_trace_reg_interesting(uint32_t reg)
+{
+    switch (reg) {
+    case ESP_TCLO:
+    case ESP_TCMID:
+    case ESP_FIFO:
+    case ESP_CMD:
+    case ESP_RSTAT:
+    case ESP_RINTR:
+    case ESP_RSEQ:
+    case ESP_RFLAGS:
+    case ESP_TCHI:
+        return true;
+    default:
+        return false;
+    }
+}
+
+static const char *c89_esp_pdma_name(uint8_t cb)
+{
+    switch (cb) {
+    case SATN_PDMA_CB:
+        return "satn";
+    case S_WITHOUT_SATN_PDMA_CB:
+        return "select-no-atn";
+    case SATN_STOP_PDMA_CB:
+        return "satn-stop";
+    case WRITE_RESPONSE_PDMA_CB:
+        return "write-response";
+    case DO_DMA_PDMA_CB:
+        return "do-dma";
+    default:
+        return "unknown";
+    }
+}
+
+static void c89_esp_trace_state(ESPState *s, const char *event,
+                                uint32_t reg, uint32_t val)
+{
+    static unsigned log_count;
+    static unsigned repeat_count;
+    static const char *last_event;
+    static uint32_t last_reg;
+    static uint32_t last_val;
+    static uint32_t last_tc;
+    static uint32_t last_stc;
+    static uint32_t last_fifo;
+    static uint32_t last_cmdfifo;
+    static uint8_t last_stat;
+    static uint8_t last_intr;
+    static uint8_t last_seq;
+    static uint8_t last_flags;
+    static int32_t last_ti_size;
+    static uint32_t last_async_len;
+    static uint32_t last_dma;
+    static int last_dma_enabled;
+    static uint8_t last_ti_cmd;
+    static bool last_data_in_ready;
+    static uint8_t last_pdma_cb;
+    static bool last_dma_cb;
+    static bool last_current_req;
+    static int last_busid;
+    static int last_sel;
+    static int last_dev;
+    static int last_lun;
+    static int last_req_dev;
+    static int last_req_lun;
+    bool noisy;
+    bool changed;
+    uint8_t stat = s->rregs[ESP_RSTAT];
+    uint8_t intr = s->rregs[ESP_RINTR];
+    uint8_t seq = s->rregs[ESP_RSEQ];
+    uint8_t flags = s->rregs[ESP_RFLAGS];
+    uint32_t tc = s->rregs[ESP_TCLO] |
+                  (s->rregs[ESP_TCMID] << 8) |
+                  (s->rregs[ESP_TCHI] << 16);
+    uint32_t stc = s->wregs[ESP_TCLO] |
+                   (s->wregs[ESP_TCMID] << 8) |
+                   (s->wregs[ESP_TCHI] << 16);
+    uint32_t fifo = fifo8_num_used(&s->fifo);
+    uint32_t cmdfifo = fifo8_num_used(&s->cmdfifo);
+    bool dma_cb = s->dma_cb != NULL;
+    bool current_req = s->current_req != NULL;
+    int busid = s->wregs[ESP_WBUSID] & BUSID_DID;
+    int sel = s->wregs[ESP_WSEL] & BUSID_DID;
+    int dev = s->current_dev ? (int)s->current_dev->id : -1;
+    int lun = (int)s->lun;
+    int req_dev = (s->current_req && s->current_req->dev) ?
+                  (int)s->current_req->dev->id : -1;
+    int req_lun = s->current_req ? (int)s->current_req->lun : -1;
+
+    noisy = ((event[0] == 'r' && event[1] == 'e') ||
+             (event[0] == 'w' && event[1] == 'r') ||
+             (event[0] == 'p' && event[1] == 'd'));
+
+    changed = !last_event || strcmp(event, last_event) != 0 ||
+              last_reg != reg || last_val != val || last_tc != tc ||
+              last_stc != stc || last_fifo != fifo ||
+              last_cmdfifo != cmdfifo || last_stat != stat ||
+              last_intr != intr || last_seq != seq ||
+              last_flags != flags || last_ti_size != s->ti_size ||
+              last_async_len != s->async_len || last_dma != s->dma ||
+              last_dma_enabled != s->dma_enabled ||
+              last_ti_cmd != s->ti_cmd ||
+              last_data_in_ready != s->data_in_ready ||
+              last_pdma_cb != s->pdma_cb || last_dma_cb != dma_cb ||
+              last_current_req != current_req ||
+              last_busid != busid || last_sel != sel || last_dev != dev ||
+              last_lun != lun || last_req_dev != req_dev ||
+              last_req_lun != req_lun;
+
+    if (noisy && !changed) {
+        repeat_count++;
+        if ((repeat_count % 65536) != 0) {
+            return;
+        }
+    } else {
+        repeat_count = 0;
+    }
+
+    if (log_count++ >= 60000) {
+        return;
+    }
+
+    fprintf(stderr,
+            "[c89-esp] n=%u repeat=%u event=%s reg=%s/0x%x val=0x%08x "
+            "busid=%d sel=%d dev=%d lun=%d req=%d req_lun=%d "
+            "stat=0x%02x intr=0x%02x seq=0x%02x flags=0x%02x "
+            "tc=%u stc=%u ti_size=%d async=%u dma=%u dma_en=%d "
+            "ti_cmd=0x%02x ready=%d pdma=%s dma_cb=%d fifo=%u "
+            "cmdfifo=%u do_cmd=%u cur=%d\n",
+            log_count, repeat_count, event, c89_esp_reg_name(reg), reg, val,
+            busid, sel, dev, lun, req_dev, req_lun, stat, intr, seq, flags,
+            tc, stc, s->ti_size, s->async_len, s->dma, s->dma_enabled,
+            s->ti_cmd, s->data_in_ready, c89_esp_pdma_name(s->pdma_cb),
+            dma_cb, fifo, cmdfifo, s->do_cmd, current_req);
+    fflush(stderr);
+
+    last_event = event;
+    last_reg = reg;
+    last_val = val;
+    last_tc = tc;
+    last_stc = stc;
+    last_fifo = fifo;
+    last_cmdfifo = cmdfifo;
+    last_stat = stat;
+    last_intr = intr;
+    last_seq = seq;
+    last_flags = flags;
+    last_ti_size = s->ti_size;
+    last_async_len = s->async_len;
+    last_dma = s->dma;
+    last_dma_enabled = s->dma_enabled;
+    last_ti_cmd = s->ti_cmd;
+    last_data_in_ready = s->data_in_ready;
+    last_pdma_cb = s->pdma_cb;
+    last_dma_cb = dma_cb;
+    last_current_req = current_req;
+    last_busid = busid;
+    last_sel = sel;
+    last_dev = dev;
+    last_lun = lun;
+    last_req_dev = req_dev;
+    last_req_lun = req_lun;
+}
+
+#define C89_ESP_TRACE(s, event, reg, val) \
+    c89_esp_trace_state((s), (event), (reg), (uint32_t)(val))
+#define C89_ESP_TRACE_REG(s, event, reg, val) \
+    do { \
+        if (c89_esp_trace_reg_interesting(reg)) { \
+            c89_esp_trace_state((s), (event), (reg), (uint32_t)(val)); \
+        } \
+    } while (0)
+#else
+#define C89_ESP_TRACE(s, event, reg, val) do { } while (0)
+#define C89_ESP_TRACE_REG(s, event, reg, val) do { } while (0)
+#endif
