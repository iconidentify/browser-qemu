+            env->aregs[7], env->mmu.tcr, env->mmu.srp, env->mmu.urp,
+            start_tb, start_pc, c89_browser_qemu_m68k_tb_flags(start_tb),
+            c89_browser_qemu_m68k_tb_cflags(start_tb),
+            c89_browser_qemu_m68k_tb_icount(start_tb),
+            last_tb, last_pc, c89_browser_qemu_m68k_tb_flags(last_tb),
+            c89_browser_qemu_m68k_tb_cflags(last_tb),
+            c89_browser_qemu_m68k_tb_icount(last_tb),
