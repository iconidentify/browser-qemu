+void c89_browser_qemu_m68k_pc_trace(CPUM68KState *env)
+{
+    static uint32_t last_pc;
+    static const char *last_phase;
+    static unsigned long long tb_count;
+    static unsigned repeat_count;
+    static unsigned log_count;
+    uint32_t pc = env->pc;
+    uint32_t sr = env->sr | cpu_m68k_get_ccr(env);
+    const char *phase = c89_browser_qemu_m68k_pc_phase(pc);
+    bool phase_changed = last_phase != phase;
+    bool pc_changed = pc != last_pc;
+    bool low_memory = pc < 0x01000000;
+    bool periodic = (tb_count % 200000ULL) == 0;
+
+    tb_count++;
+    if (!pc_changed && !phase_changed) {
+        repeat_count++;
+    }
+    if (log_count >= 1200 && !periodic) {
+        return;
+    }
+    if (log_count >= 48 && !phase_changed && !low_memory && !periodic) {
+        return;
+    }
+    if (!pc_changed && !phase_changed && !periodic) {
+        return;
+    }
+
+    fprintf(stderr,
+            "[c89-m68k-pc] tb=%llu pc=0x%08x phase=%s sr=0x%04x "
+            "d0=0x%08x d1=0x%08x d6=0x%08x d7=0x%08x "
+            "a0=0x%08x a1=0x%08x a4=0x%08x a5=0x%08x "
+            "a6=0x%08x a7=0x%08x repeat=%u\n",
+            tb_count, pc, phase, sr,
+            env->dregs[0], env->dregs[1], env->dregs[6], env->dregs[7],
+            env->aregs[0], env->aregs[1], env->aregs[4], env->aregs[5],
+            env->aregs[6], env->aregs[7], repeat_count);
+    fflush(stderr);
+
+    last_pc = pc;
+    last_phase = phase;
+    repeat_count = 0;
+    log_count++;
+}
