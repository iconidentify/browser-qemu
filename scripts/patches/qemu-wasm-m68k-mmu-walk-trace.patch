+#ifdef C89_BROWSER_QEMU_M68K_MMU_WALK_TRACE
+static bool c89_browser_qemu_m68k_mmu_walk_interesting(CPUM68KState *env,
+                                                       target_ulong address,
+                                                       int access_type)
+{
+    uint32_t pc = env->pc;
+
+    if ((env->mmu.tcr & M68K_TCR_ENABLED) == 0) {
+        return false;
+    }
+    if (pc >= 0x408815a0 && pc <= 0x40881610) {
+        return true;
+    }
+    if (address >= 0x40800000 && address < 0x40900000) {
+        return true;
+    }
+    if (address >= 0x00170000 && address < 0x00190000) {
+        return true;
+    }
+    if (access_type & ACCESS_PTEST) {
+        return true;
+    }
+    return false;
+}
+
+static void c89_browser_qemu_m68k_mmu_walk_trace(CPUM68KState *env,
+                                                  bool enabled,
+                                                  const char *stage,
+                                                  target_ulong address,
+                                                  int access_type,
+                                                  uint32_t entry,
+                                                  uint32_t desc,
+                                                  int txres,
+                                                  hwaddr physical,
+                                                  int prot,
+                                                  target_ulong page_size)
+{
+    static unsigned log_count;
+
+    if (!enabled || log_count >= 800) {
+        return;
+    }
+    log_count++;
+    fprintf(stderr,
+            "[c89-m68k-mmu-walk] n=%u stage=%s pc=0x%08x addr=0x%08x "
+            "access=0x%x entry=0x%08x desc=0x%08x tx=%d phys=0x%llx "
+            "prot=0x%x page=0x%08x tcr=0x%04x srp=0x%08x urp=0x%08x "
+            "ittr0=0x%08x ittr1=0x%08x dttr0=0x%08x dttr1=0x%08x\n",
+            log_count, stage, env->pc, (uint32_t)address, access_type,
+            entry, desc, txres, (unsigned long long)physical, prot,
+            (uint32_t)page_size, env->mmu.tcr, env->mmu.srp, env->mmu.urp,
+            env->mmu.ttr[M68K_ITTR0], env->mmu.ttr[M68K_ITTR1],
+            env->mmu.ttr[M68K_DTTR0], env->mmu.ttr[M68K_DTTR1]);
+    fflush(stderr);
+}
+#define C89_M68K_MMU_WALK_INTERESTING(env, address, access_type) \
+    c89_browser_qemu_m68k_mmu_walk_interesting(env, address, access_type)
+#define C89_M68K_MMU_WALK_TRACE(env, enabled, stage, address, access_type, \
+                                entry, desc, txres, physical, prot, page_size) \
+    c89_browser_qemu_m68k_mmu_walk_trace(env, enabled, stage, address, \
+                                         access_type, entry, desc, txres, \
+                                         physical, prot, page_size)
+#else
+#define C89_M68K_MMU_WALK_INTERESTING(env, address, access_type) false
+#define C89_M68K_MMU_WALK_TRACE(env, enabled, stage, address, access_type, \
+                                entry, desc, txres, physical, prot, page_size) \
+    do { } while (0)
+#endif
