diff --git a/hw/scsi/esp.c b/hw/scsi/esp.c
index 3eebbf67..806fc4ef 100644
--- a/hw/scsi/esp.c
+++ b/hw/scsi/esp.c
@@ -42,6 +42,10 @@
  * On Macintosh Quadra it is a NCR53C96.
  */
 
+#ifndef C89_BROWSER_QEMU_ESP_PDMA_FIFO_CAPACITY
+#define C89_BROWSER_QEMU_ESP_PDMA_FIFO_CAPACITY ESP_FIFO_SZ
+#endif
+
 #ifdef C89_BROWSER_QEMU_ESP_TRACE
 static const char *c89_esp_reg_name(uint32_t reg)
 {
@@ -1267,7 +1271,10 @@ uint64_t esp_reg_read(ESPState *s, uint32_t saddr)
