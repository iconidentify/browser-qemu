+#ifdef C89_BROWSER_QEMU_M68K_MOVEC_TLB_FLUSH
+static void c89_browser_qemu_m68k_mmu_control_flush(CPUM68KState *env,
+                                                     uint32_t reg,
+                                                     uint32_t old_val,
+                                                     uint32_t new_val)
+{
+    if (old_val == new_val) {
+        return;
+    }
+
+    tlb_flush(env_cpu(env));
+#ifdef C89_BROWSER_QEMU_M68K_TB_TRACE
+    fprintf(stderr,
+            "[c89-m68k-movec-flush] pc=0x%08x reg=0x%03x "
+            "old=0x%08x new=0x%08x tcr=0x%04x srp=0x%08x urp=0x%08x\n",
+            env->pc, reg, old_val, new_val,
+            env->mmu.tcr, env->mmu.srp, env->mmu.urp);
+    fflush(stderr);
+#endif
+}
+#define C89_M68K_MOVEC_MMU_CONTROL_FLUSH(env, reg, old_val, new_val) \
+    c89_browser_qemu_m68k_mmu_control_flush(env, reg, old_val, new_val)
+#else
+#define C89_M68K_MOVEC_MMU_CONTROL_FLUSH(env, reg, old_val, new_val) \
+    do { } while (0)
+#endif
+
